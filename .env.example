# ==========================================
# AI Smart Attendance System Environment Config
# ==========================================

# Database Configurations
# Default: database/attendance.db relative to project root
DATABASE_PATH=database/attendance.db

# Recognition Threshold for Cosine Similarity
# Range: 0.0 to 1.0 (Higher means stricter matching)
RECOGNITION_THRESHOLD=0.6

# Hardware settings
# Default webcam index (0 is usually the built-in system camera)
CAMERA_INDEX=0

# Application Modes
# Set to True to bypass webcam hardware requirements and run simulated data
DEMO_MODE=False
